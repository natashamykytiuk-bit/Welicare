{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": []
  },
  "include": [
    "App.js",
    "screens/**/*.js",
    "components/**/*.js",
    "utils/**/*.js",
    "contexts/**/*.js",
    "types/**/*.js"
  ],
  "exclude": ["node_modules", "functions", "scripts", ".agents", "Claude outputs"]
}
