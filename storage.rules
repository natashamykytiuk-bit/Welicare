rules_version = '2';

// Cloud Storage security rules. The app stores three kinds of JPEG:
//   residents/{residentId}/photos/{photoId}.jpg  album (utils/residentPhotos.js)
//   residents/{residentId}/profile.jpg           resident profile photo
//   users/{uid}/avatar.jpg                       optional user avatar
// (the last two: utils/profilePhotos.js).
// Everything else is denied by default (no rule matches → no access).
//
// Storage has no idea who is linked to which resident — that lives in
// Firestore — so these rules read the resident doc and the requester's
// users doc with cross-service calls (firestore.get / firestore.exists),
// mirroring the /residents/{residentId}/photos rules in firestore.rules.
// Note: every cross-service call is billed as a Firestore document read,
// so each photo view, upload or delete costs up to two reads (the
// resident doc and the user's doc).
service firebase.storage {
  match /b/{bucket}/o {
    // Signed in with a verified email address — same as verified() in
    // firestore.rules.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The requester's own users/{uid} doc (role, orgId).
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // The resident's doc in Firestore.
    function residentDoc(residentId) {
      return firestore.get(/databases/(default)/documents/residents/$(residentId)).data;
    }

    // Same logic as linkedToResident() in firestore.rules: the resident's
    // creator or caregiver, anyone on its assignedCaregivers or
    // familyMembers list, or Caregiver/Administrator/Volunteer staff of its
    // facility. Family Caregivers only get in through the direct links —
    // being in the same facility isn't enough for them.
    function linkedToResident(residentId) {
      let r = residentDoc(residentId);
      return r.get('caregiverId', null) == request.auth.uid ||
        r.get('createdBy', null) == request.auth.uid ||
        (r.get('assignedCaregivers', null) is list && request.auth.uid in r.assignedCaregivers) ||
        (r.get('familyMembers', null) is list && request.auth.uid in r.familyMembers) ||
        (r.get('facilityId', null) != null && me().get('orgId', null) == r.facilityId &&
          me().role in ['Caregiver', 'Administrator', 'Volunteer']);
    }

    // A Family Caregiver's auto-created family organization (isPersonal),
    // as opposed to a care facility — isFamilyOrg() in firestore.rules.
    function isFamilyOrg(facilityId) {
      return firestore.get(/databases/(default)/documents/organizations/$(facilityId)).data.get('isPersonal', false) == true;
    }

    // May change this resident's profile photo — the same people who may
    // edit the profile, mayEditResident() in firestore.rules: a
    // Caregiver/Administrator in the resident's facility, or a Family
    // Caregiver for a resident they added that is still at home (in no
    // organization, or in their family organization). Never volunteers, and
    // never family once the resident has moved into a facility.
    function mayEditResidentPhoto(residentId) {
      let r = residentDoc(residentId);
      return (
        me().role in ['Caregiver', 'Administrator'] &&
        r.get('facilityId', null) != null && me().get('orgId', null) == r.facilityId
      ) || (
        me().role == 'Family Caregiver' &&
        (r.get('caregiverId', null) == request.auth.uid || r.get('createdBy', null) == request.auth.uid) &&
        (r.get('facilityId', null) == null || isFamilyOrg(r.facilityId))
      );
    }

    // The resident's profile photo. One file, replaced in place, so unlike
    // the album an overwrite (update) IS allowed here.
    match /residents/{residentId}/profile.jpg {
      allow read: if verified() &&
        firestore.exists(/databases/(default)/documents/residents/$(residentId)) &&
        linkedToResident(residentId);

      allow create, update: if verified() &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg' &&
        request.resource.metadata != null &&
        request.resource.metadata.get('uploadedBy', null) == request.auth.uid &&
        firestore.exists(/databases/(default)/documents/residents/$(residentId)) &&
        mayEditResidentPhoto(residentId);

      allow delete: if verified() &&
        firestore.exists(/databases/(default)/documents/residents/$(residentId)) &&
        mayEditResidentPhoto(residentId);
    }

    // A user's optional avatar: only they can change it; they and people
    // in the same organization can see it. Reading the target user's doc
    // here is fine even though the Firestore rules wouldn't let the viewer
    // read it — cross-service reads aren't subject to firestore.rules, and
    // only orgId is compared, never returned.
    match /users/{userId}/avatar.jpg {
      allow read: if verified() && (
        request.auth.uid == userId ||
        (
          me().get('orgId', null) != null &&
          firestore.exists(/databases/(default)/documents/users/$(userId)) &&
          me().orgId == firestore.get(/databases/(default)/documents/users/$(userId)).data.get('orgId', null)
        )
      );

      allow create, update: if verified() && request.auth.uid == userId &&
        request.resource.size < 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';

      allow delete: if verified() && request.auth.uid == userId;
    }

    match /residents/{residentId}/photos/{fileName} {
      // Viewing: anyone linked to the resident (volunteers included, since
      // any linked account can run Resident Mode).
      allow read: if verified() &&
        firestore.exists(/databases/(default)/documents/residents/$(residentId)) &&
        linkedToResident(residentId);

      // Uploading: linked Family Caregivers, Caregivers and Administrators
      // only, a JPEG under 5 MB (the app sends ~1600px at 80% quality,
      // well under that), stamped with the uploader's own uid, named like
      // the app names them. `resource == null`: Storage treats uploading
      // over an existing file as a create, not an update, so this is what
      // stops a photo being replaced.
      allow create: if verified() &&
        resource == null &&
        fileName.matches('^[A-Za-z0-9_-]{1,128}[.]jpg$') &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg' &&
        request.resource.metadata != null &&
        request.resource.metadata.get('uploadedBy', null) == request.auth.uid &&
        firestore.exists(/databases/(default)/documents/residents/$(residentId)) &&
        linkedToResident(residentId) &&
        me().role in ['Family Caregiver', 'Caregiver', 'Administrator'];

      // Metadata changes are never allowed; together with `resource ==
      // null` above, a photo can't be altered — delete and re-upload.
      allow update: if false;

      // The uploader, or anyone who may add photos to this album (the same
      // linked Family Caregivers, Caregivers and Administrators as `create`
      // above) — same as the photos delete rule in firestore.rules.
      allow delete: if verified() && (
        (resource.metadata != null && resource.metadata.get('uploadedBy', null) == request.auth.uid) ||
        (
          firestore.exists(/databases/(default)/documents/residents/$(residentId)) &&
          linkedToResident(residentId) &&
          me().role in ['Family Caregiver', 'Caregiver', 'Administrator']
        )
      );
    }
  }
}
