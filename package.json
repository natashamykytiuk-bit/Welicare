{
  "name": "welicare",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.15.0",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only firestore --project demo-welicare \"jest -c tests/rules/jest.config.js\"",
    "emulators": "firebase emulators:start --project demo-welicare",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions --project demo-welicare \"jest -c tests/functions/jest.config.js\""
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/",
      "/tests/rules/",
      "/tests/functions/"
    ],
    "testTimeout": 30000
  }
}
