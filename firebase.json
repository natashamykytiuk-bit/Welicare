{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "postdeploy": [
      "gcloud run services add-iam-policy-binding generatesuggestions --region=us-central1 --member=allUsers --role=roles/run.invoker --project=welicare",
      "gcloud run services add-iam-policy-binding searchyoutube --region=us-central1 --member=allUsers --role=roles/run.invoker --project=welicare",
      "gcloud run services add-iam-policy-binding deleteaccount --region=us-central1 --member=allUsers --role=roles/run.invoker --project=welicare",
      "gcloud run services add-iam-policy-binding deleteorganization --region=us-central1 --member=allUsers --role=roles/run.invoker --project=welicare",
      "gcloud run services add-iam-policy-binding listorgmembers --region=us-central1 --member=allUsers --role=roles/run.invoker --project=welicare",
      "gcloud run services add-iam-policy-binding transferorgadmin --region=us-central1 --member=allUsers --role=roles/run.invoker --project=welicare"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    }
  }
}
