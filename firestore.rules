rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---------------------------------------------------------

    // Signed in AND the email address has been verified (the email_verified
    // claim in the ID token, set by Firebase Auth — the app can't fake it).
    // Required for everything that touches residents, organizations and the
    // libraries. Only sign-up's own writes (the user's profile, username
    // and personal organization) are allowed before verification.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The signed-in user's own users/{uid} doc (role, orgId, …).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Roles that may see every resident in their facility (and pick one via
    // "Select from [Organization]" to view it). Family Caregivers are left
    // out on purpose: a relative who joins a care home's organization must
    // only see the residents they're linked to, not everyone living there.
    function seesWholeFacility() {
      return me().role in ['Caregiver', 'Administrator', 'Volunteer'];
    }

    // True if the signed-in user is linked to this resident directly — its
    // creator, or on its assignedCaregivers list — or is facility staff in
    // the same facility (see seesWholeFacility). `r` is the resident doc's
    // data.
    function linkedToResident(r) {
      return r.caregiverId == request.auth.uid ||
        r.createdBy == request.auth.uid ||
        (r.assignedCaregivers is list && request.auth.uid in r.assignedCaregivers) ||
        (r.facilityId != null && me().orgId == r.facilityId && seesWholeFacility());
    }

    // False while an organization is being deleted (the deleteOrganization
    // Cloud Function marks it status: 'deleting' first). New residents and
    // library entries are refused for it then, so nothing new can appear
    // while it's being cleaned up. A missing org counts as not accepting.
    function orgAcceptingNewData(facilityId) {
      return exists(/databases/$(database)/documents/organizations/$(facilityId)) &&
        get(/databases/$(database)/documents/organizations/$(facilityId)).data.get('status', 'active') != 'deleting';
    }

    // The per-organization "Manage Volunteer Permissions" switch (stored on
    // the org doc as volunteerPermissions.canViewLifeStories). Off unless an
    // administrator turned it on.
    function volunteersMayViewLifeStories(facilityId) {
      return facilityId != null &&
        get(/databases/$(database)/documents/organizations/$(facilityId)).data
          .get('volunteerPermissions', {}).get('canViewLifeStories', false) == true;
    }

    // A signed-in user can only read/write their own profile doc
    // (users/{their own uid}) — never anyone else's. This covers the
    // profile fields set at sign-up (email, username, role) and the
    // pinHash added later by PINSetupScreen.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // Role is picked once at sign-up (SignUpScreen) and must be one of
      // the four real roles — the same values ModeSelectionScreen and the
      // rules below branch on.
      // No orgId at sign-up either — it's set afterwards through one of the
      // controlled paths below.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role in ['Family Caregiver', 'Caregiver', 'Volunteer', 'Administrator'] &&
        !('orgId' in request.resource.data);

      // Everything else on your own doc (username, pinHash, …) stays
      // self-editable, but never `role` — otherwise anyone could make
      // themselves an Administrator. Role changes only happen server-side
      // via the Admin SDK (transferOrgAdmin), which bypasses these rules.
      //
      // orgId is what every org-scoped rule trusts (residents, musicLibrary),
      // so it can't be set to an arbitrary organization either. The client
      // may only point it at an org the user created themselves
      // (createOrganization / createPersonalOrganization) or clear it.
      // Joining someone else's org by invite code goes through the
      // joinOrganization Cloud Function instead, which checks the code.
      //
      // getAfter (not get) reads the org as it will be once this request
      // finishes. That lets createPersonalOrganization create the org and
      // point orgId at it in ONE batch — get() would still see the org as
      // missing mid-batch. For a single write it's the same as get().
      allow update: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId']) ||
          // (Clearing your own orgId used to be allowed, which let people
          // leave a facility and join another while keeping access. Only
          // the server clears it now — removeOrgMember, deleteOrganization.)
          getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid
        );
    }

    // Public lookup collection keyed by lowercased username, used to
    // enforce uniqueness (sign-up, ChangeUsernameScreen) and to resolve a
    // username to an email for sign-in-by-username — both need to work
    // before/without the person being signed in as themselves.
    match /usernames/{usernameLower} {
      // Public read, so sign-up can check a username is free before the
      // account exists. The doc holds only the owning account's id — never
      // the email. Signing in with a username goes through the
      // resolveSignInEmail Cloud Function instead, which reads the real
      // email from Firebase Auth and is rate-limited.
      allow get: if true;
      // Only the account it belongs to can claim it; only if this exact
      // username isn't already taken (`create` only matches when no doc
      // exists yet); with nothing but { uid }; and only if it's the
      // username on the claimer's own profile (getAfter, so it also works
      // when the profile's username changes in the same batch — see
      // ChangeUsernameScreen). That keeps one real username per account,
      // instead of claiming extra names that point somewhere misleading.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.trim().lower() == usernameLower;
      // Only the owner can release their own old username (used when
      // changing usernames).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
      allow list: if false;
    }

    // Residents can be shared across an organization. caregiverId is the
    // creator (checked on create); createdBy is the same value, kept for
    // back-compat with residents created before org-wide sharing existed.
    // assignedCaregivers lists every caregiver who has added this resident
    // to their own list. facilityId links a resident to an organization —
    // it's null for residents created outside of one.
    match /residents/{residentId} {
      // Split into get/list rather than one combined `read`: Firestore
      // validates list/query requests against the rule's structure before
      // running the query, and can't reliably prove safety when a plain
      // field-match OR-branch is mixed with a get()-based one in the same
      // rule — it just rejects the whole query with permission-denied, even
      // when the branch that would actually apply doesn't use get() at all.
      // That's what broke ResidentModeScreen's createdBy/assignedCaregivers
      // queries. Single-document get()s (ActivityMenuScreen,
      // BuildProfileScreen, AISuggestionsScreen) don't have this problem —
      // they're evaluated once with no query to validate — so `get` below
      // keeps the full combined condition.
      allow get: if verified() && (
        resource.data.caregiverId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.assignedCaregivers is list && request.auth.uid in resource.data.assignedCaregivers) ||
        (resource.data.facilityId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId &&
          seesWholeFacility())
      );

      // Powers ResidentModeScreen's two queries: where('createdBy','==',uid)
      // and where('assignedCaregivers','array-contains',uid). The
      // assignedCaregivers branch MUST be the bare `uid in resource.data.X`
      // form — wrapping it in `X is list && uid in X` (as the get/update
      // rules do, safely, since those are evaluated per-document) breaks
      // Firestore's ability to structurally match it against an
      // array-contains query filter, and the whole list request gets
      // rejected as permission-denied. The type-guard is redundant here
      // anyway: array-contains itself guarantees the field is an array
      // containing the value for any document the query could return.
      allow list: if verified() && (
        resource.data.caregiverId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.assignedCaregivers
      );

      // Powers SelectOrganizationResidentScreen's
      // where('facilityId','==',orgId) query. Kept as its own rule (not
      // OR'd into the one above) so Firestore can validate this query shape
      // independently of the plain field-match one. Family Caregivers can't
      // run it (seesWholeFacility) — they only list their own residents.
      allow list: if verified() && resource.data.facilityId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId &&
        seesWholeFacility();

      // A new resident must be self-attributed — the creator's own uid has
      // to be the caregiverId being written.
      // It also has to land in the creator's own organization (or none) —
      // otherwise anyone could plant residents in another facility.
      //
      // The whole new document is validated, not just caregiverId: only the
      // fields AddResidentScreen writes are allowed, createdBy must also be
      // the creator, and assignedCaregivers must be exactly [creator] — so
      // nobody can pre-assign other people (which would grant them access
      // through the assignment rules) or forge who created it.
      allow create: if verified() &&
        request.resource.data.keys().hasOnly(['name', 'caregiverId', 'createdBy', 'facilityId', 'assignedCaregivers', 'createdAt', 'hasLifeStory', 'musicProvider']) &&
        request.resource.data.caregiverId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.assignedCaregivers == [request.auth.uid] &&
        (
          request.resource.data.get('facilityId', null) == null ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == request.resource.data.facilityId &&
            orgAcceptingNewData(request.resource.data.facilityId)
          )
        );

      allow update: if verified() && (
        // The creator or an already-assigned caregiver may edit the
        // resident's profile fields only (name, life story, music picks and
        // favourites — everything BuildProfile, CurateResidentMusic and the
        // music screens write). Never facilityId, createdBy, caregiverId or
        // the assignedCaregivers list, so an assigned caregiver can't move
        // a resident to another org, take ownership, or add/remove others.
        (
          (
            resource.data.caregiverId == request.auth.uid ||
            resource.data.createdBy == request.auth.uid ||
            (resource.data.assignedCaregivers is list && request.auth.uid in resource.data.assignedCaregivers)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'preferredName', 'hasLifeStory', 'lifeStory', 'selectedMusicVideoIds', 'favouriteMusicVideoIds', 'selectedMovieVideoIds', 'favouriteMovieVideoIds']) &&
          // The life story itself now lives in private/lifeStory; the old
          // field may only be removed (by a save), never written. Leaving it
          // untouched is fine — residents not migrated yet still have it.
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifeStory']) ||
            request.resource.data.get('lifeStory', null) == null
          )
        ) ||
        // Self-assignment: a caregiver in the same organization who isn't
        // assigned yet may add themselves to assignedCaregivers and change
        // nothing else — this is what "Select from [Organization]" does.
        // Only Caregivers and Administrators: being assigned grants profile
        // editing and life-story access, which Volunteers and Family
        // Caregivers mustn't be able to hand themselves.
        (
          resource.data.facilityId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Caregiver', 'Administrator'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedCaregivers']) &&
          request.resource.data.assignedCaregivers == resource.data.assignedCaregivers.concat([request.auth.uid])
        ) ||
        // Profile editing from CaregiverResidentsScreen ("My Residents"):
        // any Caregiver/Administrator in the same facility may update a
        // resident's profile fields, even if not assigned to them — the
        // same field list as above, so ownership/facility/sharing fields
        // can't be changed this way. Family Members and Volunteers are
        // excluded.
        (
          resource.data.facilityId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Caregiver', 'Administrator'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'preferredName', 'hasLifeStory', 'lifeStory', 'selectedMusicVideoIds', 'favouriteMusicVideoIds', 'selectedMovieVideoIds', 'favouriteMovieVideoIds']) &&
          // The life story itself now lives in private/lifeStory; the old
          // field may only be removed (by a save), never written. Leaving it
          // untouched is fine — residents not migrated yet still have it.
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifeStory']) ||
            request.resource.data.get('lifeStory', null) == null
          )
        )
      );

      // Deleting removes the resident for every caregiver it's shared
      // with, so it's restricted to Administrators rather than the
      // creator — and only Administrators of the resident's own facility,
      // never another organization's. Both role and orgId are read from
      // the requester's own user doc, which they can't forge (see the
      // users rules above).
      allow delete: if verified() &&
        resource.data.facilityId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId;

      // The resident's life story — kept in its own doc so it can have
      // stricter rules than the resident's name and activity info (Firestore
      // rules can't hide individual fields). See utils/residentLifeStory.js.
      match /private/{docId} {
        // Readable by anyone linked to the resident, except volunteers — they
        // only see it when their organization turned on "Volunteers can view
        // life stories" in Organizational Settings.
        allow get: if verified() &&
          linkedToResident(get(/databases/$(database)/documents/residents/$(residentId)).data) &&
          (me().role != 'Volunteer' ||
            volunteersMayViewLifeStories(get(/databases/$(database)/documents/residents/$(residentId)).data.facilityId));

        // Writing (BuildProfile's save) follows the same people who may edit
        // the resident's profile, but never volunteers.
        allow create, update: if verified() && me().role != 'Volunteer' && (
          get(/databases/$(database)/documents/residents/$(residentId)).data.caregiverId == request.auth.uid ||
          get(/databases/$(database)/documents/residents/$(residentId)).data.createdBy == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/residents/$(residentId)).data.get('assignedCaregivers', []) ||
          (
            get(/databases/$(database)/documents/residents/$(residentId)).data.facilityId != null &&
            me().orgId == get(/databases/$(database)/documents/residents/$(residentId)).data.facilityId &&
            me().role in ['Caregiver', 'Administrator']
          )
        );

        // Deleted together with the resident, by the same people.
        allow delete: if verified() &&
          me().role == 'Administrator' &&
          me().orgId == get(/databases/$(database)/documents/residents/$(residentId)).data.facilityId;
      }
    }

    // Any signed-in user can fetch a single organization by id (to display
    // a facility name) or create one as themselves; only the creator can
    // edit or remove it.
    //
    // No `list`: that would let anyone query every organization and read
    // off all the invite codes, then join any facility. Looking an org up
    // by code happens server-side instead (joinOrganization,
    // generateInviteCode Cloud Functions).
    match /organizations/{orgId} {
      allow get: if verified();

      // The app only ever creates *personal* organizations itself
      // (createPersonalOrganization at Family Caregiver sign-up). Real
      // organizations are created server-side by the createOrganization
      // Cloud Function, which also mints the invite code — so a
      // client-created org must be personal, owned by its creator, and
      // carry no invite code.
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.adminId == request.auth.uid &&
        request.resource.data.isPersonal == true &&
        !('inviteCode' in request.resource.data);

      // The owner may edit the display details OrganizationalSettingsScreen
      // shows, and nothing else. In particular not createdBy/adminId
      // (ownership moves via transferOrgAdmin) and not isPersonal —
      // flipping a real facility to "personal" would make deleteAccount
      // wipe all of its residents.
      allow update: if verified() && resource.data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'type', 'province', 'city', 'volunteerPermissions']) &&
        // Manage Volunteer Permissions: currently one yes/no switch.
        (
          !('volunteerPermissions' in request.resource.data) ||
          (
            request.resource.data.volunteerPermissions.keys().hasOnly(['canViewLifeStories']) &&
            request.resource.data.volunteerPermissions.get('canViewLifeStories', false) is bool
          )
        );

      // No client deletes: deleteOrganization (Cloud Function) removes the
      // org together with its residents, library and invite codes.

      // The org's current invite code, for OrgIdBadge and the settings
      // screens. Readable by the org's own members only; written only by
      // the Cloud Functions that issue codes.
      match /private/{docId} {
        allow get: if verified() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
      }
    }

    // Curated movie library (MovieLibraryScreen, CurateResidentMoviesScreen,
    // MoviesSelectionScreen) — its own collection, independent of music, but
    // with the same rules as musicLibrary: readable within your own
    // organization (plus a shared "global" list, which only the Admin SDK
    // can write); written only by Caregivers/Administrators, only in their
    // own organization; an entry's facilityId and videoId can never change,
    // and only the form's fields may be edited. No artist field — movies are
    // tagged by genre and decade only.
    match /movieLibrary/{entryId} {
      allow get: if verified() && (
        resource.data.facilityId == 'global' ||
        (resource.data.facilityId != null && me().orgId == resource.data.facilityId)
      );

      // Two list rules for the same reason as musicLibrary: each query
      // (facilityId == 'global', facilityId == your org) must match one
      // branch on its own.
      allow list: if verified() && resource.data.facilityId == 'global';
      allow list: if verified() && resource.data.facilityId != null &&
        me().orgId == resource.data.facilityId;

      allow create: if verified() &&
        me().role in ['Caregiver', 'Administrator'] &&
        request.resource.data.facilityId != 'global' &&
        request.resource.data.facilityId == me().orgId &&
        orgAcceptingNewData(request.resource.data.facilityId) &&
        request.resource.data.keys().hasOnly(['videoId', 'title', 'channelTitle', 'thumbnailUrl', 'genres', 'decade', 'facilityId', 'addedAt', 'addedByUid']);

      allow update: if verified() &&
        me().role in ['Caregiver', 'Administrator'] &&
        resource.data.facilityId != 'global' &&
        resource.data.facilityId == me().orgId &&
        request.resource.data.facilityId == resource.data.facilityId &&
        request.resource.data.videoId == resource.data.videoId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'channelTitle', 'genres', 'decade', 'thumbnailUrl', 'addedAt', 'addedByUid']) &&
        (request.resource.data.get('addedByUid', null) == resource.data.get('addedByUid', null) ||
          request.resource.data.addedByUid == request.auth.uid);

      allow delete: if verified() &&
        me().role in ['Caregiver', 'Administrator'] &&
        resource.data.facilityId != 'global' &&
        resource.data.facilityId == me().orgId;
    }

    // Invite-code lookup table and join rate-limit counters. Server-only —
    // read and written exclusively by Cloud Functions through the Admin SDK
    // (joinOrganization, createOrganization, regenerateInviteCode, …), so
    // codes can't be enumerated and limits can't be reset from the app.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Shared video library powering Music (MusicSelectionScreen). Each
    // entry is scoped by facilityId: either the literal string "global"
    // (the shared admin-curated baseline — written only by
    // scripts/seedMusicLibrary.js and
    // scripts/migrateMusicLibraryFacilityScope.js via IAM-authenticated
    // REST calls, which bypass these rules entirely, never through the
    // app) or a real organization id, matching the caregiver's own
    // users/{uid}.orgId the same way residents.facilityId does.
    match /musicLibrary/{entryId} {
      // Split into get/list rather than one combined `read`, same reason
      // the residents rules above are split: Firestore can't validate a
      // list/query request against a rule that ORs a plain field-match
      // branch ("global") with a get()-based branch (the org match) — it
      // rejects the whole query with permission-denied even when the
      // branch that would actually apply doesn't use get() at all. Each
      // branch below is instead its own `allow list`, and the app queries
      // facilityId with two separate `==` requests (see
      // queryMusicLibrarySubset) rather than a single `in`, so each query
      // only ever needs to satisfy one of these two rules on its own.
      allow get: if verified() && (
        resource.data.facilityId == 'global' ||
        (resource.data.facilityId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId)
      );

      allow list: if verified() && resource.data.facilityId == 'global';

      allow list: if verified() && resource.data.facilityId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId;

      // Writes are Caregiver/Administrator only, and further scoped so the
      // app itself can never create/edit/remove a "global" entry — those
      // are curated out-of-band by the scripts above, not through
      // ManageMusicScreen/MusicLibraryScreen (which greys out those
      // controls for global entries to match).
      allow create: if verified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Caregiver', 'Administrator'] &&
        request.resource.data.facilityId != 'global' &&
        request.resource.data.facilityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId &&
        orgAcceptingNewData(request.resource.data.facilityId);

      // Update checks the entry as it is now AND as it will be: facilityId
      // and videoId can never change (so an entry can't be moved into
      // "global" or another org, or turned into a different video), and only
      // the fields the add/edit form writes may change. addedByUid may only
      // stay as it is or become the caller (a retry of their own add).
      allow update: if verified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Caregiver', 'Administrator'] &&
        resource.data.facilityId != 'global' &&
        resource.data.facilityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId &&
        request.resource.data.facilityId == resource.data.facilityId &&
        request.resource.data.videoId == resource.data.videoId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'channelTitle', 'artist', 'genres', 'decade', 'thumbnailUrl', 'addedAt', 'addedByUid']) &&
        (request.resource.data.get('addedByUid', null) == resource.data.get('addedByUid', null) ||
          request.resource.data.addedByUid == request.auth.uid);

      allow delete: if verified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Caregiver', 'Administrator'] &&
        resource.data.facilityId != 'global' &&
        resource.data.facilityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }
  }
}
