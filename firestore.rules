rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can only read/write their own profile doc
    // (users/{their own uid}) — never anyone else's. This covers the
    // profile fields set at sign-up (email, username, role) and the
    // pinHash added later by PINSetupScreen.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public lookup collection keyed by lowercased username, used to
    // enforce uniqueness (sign-up, ChangeUsernameScreen) and to resolve a
    // username to an email for sign-in-by-username — both need to work
    // before/without the person being signed in as themselves.
    match /usernames/{usernameLower} {
      // Public read: needed to resolve a username to an email before the
      // person is signed in (sign-in-by-username) and to check
      // availability during sign-up/username changes.
      allow get: if true;
      // Only the account it belongs to can claim it, and only if this
      // exact username isn't already taken — `create` only matches when
      // no document currently exists at this path, so a second person
      // trying to grab the same username hits `update` semantics instead
      // and is rejected below.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Only the owner can release their own old username (used when
      // changing usernames).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
      allow list: if false;
    }

    // Residents can be shared across an organization. caregiverId is the
    // creator (checked on create); createdBy is the same value, kept for
    // back-compat with residents created before org-wide sharing existed.
    // assignedCaregivers lists every caregiver who has added this resident
    // to their own list. facilityId links a resident to an organization —
    // it's null for residents created outside of one.
    match /residents/{residentId} {
      // Split into get/list rather than one combined `read`: Firestore
      // validates list/query requests against the rule's structure before
      // running the query, and can't reliably prove safety when a plain
      // field-match OR-branch is mixed with a get()-based one in the same
      // rule — it just rejects the whole query with permission-denied, even
      // when the branch that would actually apply doesn't use get() at all.
      // That's what broke ResidentModeScreen's createdBy/assignedCaregivers
      // queries. Single-document get()s (ActivityMenuScreen,
      // BuildProfileScreen, AISuggestionsScreen) don't have this problem —
      // they're evaluated once with no query to validate — so `get` below
      // keeps the full combined condition.
      allow get: if request.auth != null && (
        resource.data.caregiverId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.assignedCaregivers is list && request.auth.uid in resource.data.assignedCaregivers) ||
        (resource.data.facilityId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId)
      );

      // Powers ResidentModeScreen's two queries: where('createdBy','==',uid)
      // and where('assignedCaregivers','array-contains',uid). The
      // assignedCaregivers branch MUST be the bare `uid in resource.data.X`
      // form — wrapping it in `X is list && uid in X` (as the get/update
      // rules do, safely, since those are evaluated per-document) breaks
      // Firestore's ability to structurally match it against an
      // array-contains query filter, and the whole list request gets
      // rejected as permission-denied. The type-guard is redundant here
      // anyway: array-contains itself guarantees the field is an array
      // containing the value for any document the query could return.
      allow list: if request.auth != null && (
        resource.data.caregiverId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.assignedCaregivers
      );

      // Powers SelectOrganizationResidentScreen's
      // where('facilityId','==',orgId) query. Kept as its own rule (not
      // OR'd into the one above) so Firestore can validate this query shape
      // independently of the plain field-match one.
      allow list: if request.auth != null && resource.data.facilityId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId;

      // A new resident must be self-attributed — the creator's own uid has
      // to be the caregiverId being written.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.caregiverId;

      allow update: if request.auth != null && (
        // Full write access: the creator or an already-assigned caregiver
        // (covers e.g. BuildProfileScreen editing a shared resident's
        // lifeStory).
        resource.data.caregiverId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.assignedCaregivers is list && request.auth.uid in resource.data.assignedCaregivers) ||
        // Self-assignment: a caregiver in the same organization who isn't
        // assigned yet may add themselves to assignedCaregivers and change
        // nothing else — this is what "Select from [Organization]" does.
        (
          resource.data.facilityId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.facilityId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedCaregivers']) &&
          request.resource.data.assignedCaregivers == resource.data.assignedCaregivers.concat([request.auth.uid])
        )
      );

      // Deleting removes the resident for every caregiver it's shared
      // with, so it's restricted to Administrators rather than the
      // creator — role is read from the requester's own user doc, the
      // same field ModeSelectionScreen and JoinCreateOrganizationScreen
      // already branch on.
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator';
    }

    // Any signed-in user can read an organization (needed to look up an
    // invite code or display a facility name) or create one; only the
    // creator can edit or remove it.
    match /organizations/{orgId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Shared video library powering Music (MusicSelectionScreen) — a single
    // global catalog, not scoped by facilityId, so it's curated once and
    // reused by every organization. Read access still requires being part
    // of *some* organization (same orgId-lookup shape the residents rules
    // above use for facility-scoped access), so only signed-in staff can
    // browse it. Writes (ManageMusicScreen / MusicLibraryScreen) are
    // restricted to Caregiver/Administrator, mirroring the role read on
    // ResidentModeScreen's delete check and ModeSelectionScreen's
    // Caregiver Mode visibility.
    match /musicLibrary/{entryId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Caregiver', 'Administrator'];
    }
  }
}
